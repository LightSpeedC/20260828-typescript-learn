# 生成物・一時ファイル（HTML から作り直せる）
tmp/

# セッションログ・補助ファイル
etc/

# 自動生成するログ・レポート
logs/

# 非公開（先頭 _ は全階層で管理外。末尾に / を付けるとファイルが残る）
_*

# ローカル設定（チームで共有するものだけ名指しで許可する）
.claude/*
!.claude/settings.json
!.claude/commands/
!.claude/agents/
!.claude/skills/

# Node
node_modules/
dist/
*.tsbuildinfo

# Windows
Thumbs.db
desktop.ini
